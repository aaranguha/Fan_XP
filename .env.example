# ── Ticketmaster ──────────────────────────────────────────────────────────────
# Get from: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=your_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
# Use the service_role key (not anon) — it bypasses RLS for server-side writes.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── GitHub (Railway only) ─────────────────────────────────────────────────────
# Only needed when running on Railway so the runner can git push after a game.
# Create at: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=your_github_personal_access_token
GIT_USER_NAME=your_github_username
GIT_USER_EMAIL=your_github_email
